<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_TEST" Id="{b11a1fb5-d6e4-49fe-818b-babb37f97803}" SpecialFunc="None">
    <Declaration><![CDATA[
(*
    Runs all MBIDivB test suites with TcUnit. Call it from the test task
    (1 ms cycle time).
*)
PROGRAM PRG_TEST
VAR
    TimeTest : FB_TimeTest;
    ParameterTest : FB_ParameterTest;
    AnalogInputTest : FB_AnalogInputTest;
    CounterTimerTest : FB_CounterTimerTest;
    AnalogOutputTest : FB_AnalogOutputTest;
    MultiTriggerTest : FB_MultiTriggerTest;
    FlowMeterTest : FB_FlowMeterTest;
    ShutterControlTest : FB_ShutterControlTest;
    LedControlTest : FB_LedControlTest;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
TcUnit.RUN();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_AoCmd" Id="{acb63dbf-63b5-4af3-a8dd-d5426962b233}">
    <Declaration><![CDATA[
(*
    Commands of FB_AnalogOutput. Write TRUE; the block sets the flag back to
    FALSE when it has processed the command.
*)
TYPE ST_AoCmd :
STRUCT
    Start : BOOL;  // start the waveform playback (waveform mode only)
    Stop : BOOL;   // stop the waveform playback and hold the present value
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
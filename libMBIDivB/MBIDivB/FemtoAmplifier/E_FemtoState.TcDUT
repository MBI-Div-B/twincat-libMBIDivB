<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FemtoState" Id="{f04d0066-4206-4a9e-8cbb-a17a967434b3}">
    <Declaration><![CDATA[
(*
    States of FB_FemtoAmplifier, reported as Status.State (code) and
    Status.StateText (name).
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_FemtoState :
(
    READY := 0,     // settings in use have settled
    SETTLING := 1   // within the settling time after a change or a PLC start
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_CtCmd" Id="{4d60549b-28f8-4edb-9bc7-147d1b12813b}">
    <Declaration><![CDATA[
(*
    Commands of FB_CounterTimer. Write TRUE; the block sets the flag back to
    FALSE when it has processed the command.
*)
TYPE ST_CtCmd :
STRUCT
    Start : BOOL;  // start a new acquisition from point 1
    Stop : BOOL;   // stop; keep the points already stored
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CtState" Id="{591155c6-f965-4d72-ab8d-eca8525ab227}">
    <Declaration><![CDATA[
(*
    States of FB_CounterTimer, reported as Status.State (code) and
    Status.StateText (name).
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_CtState :
(
    IDLE := 0,          // no acquisition running
    INTEGRATING := 1,   // integration window in progress (timed: armed for the next cycle)
    LATENCY := 2,       // timed mode: latency between two windows
    WAIT_TRIGGER := 3   // trigger mode: waiting for the next rising edge of Gate
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
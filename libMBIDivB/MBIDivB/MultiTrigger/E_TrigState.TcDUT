<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_TrigState" Id="{90d7518e-b1d8-4551-9148-5c3adf7a2b3a}">
    <Declaration><![CDATA[
(*
    States of FB_MultiTrigger, reported as Status.State (code) and
    Status.StateText (name).
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_TrigState :
(
    IDLE := 0,   // no pulse train running, output low
    DELAY := 1,  // waiting for the delay time, output low
    HIGH := 2,   // high phase of a pulse
    LOW := 3     // low phase between two pulses
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
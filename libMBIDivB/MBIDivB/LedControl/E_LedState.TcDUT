<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_LedState" Id="{56553e79-7430-4513-bd19-f3b01fcec4dd}">
    <Declaration><![CDATA[
(*
    States of FB_LedControl, reported as Status.State (code) and
    Status.StateText (name).
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LedState :
(
    OFF := 0,       // LED off
    ON := 1,        // LED on
    TIMEOUT := 2,   // switched off by the maximum on time
    FAULT := 3      // switched off by a terminal error
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
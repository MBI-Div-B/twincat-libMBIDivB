<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Param" Id="{b527109a-efff-486c-8301-3e29bfd09b59}" ParameterList="True">
    <Declaration><![CDATA[
(*
    Library parameters: buffer lengths and channel counts.

    Each experiment project can override these values in its Library Manager
    (select the MBIDivB reference, tab "Library Parameters"). All buffers are
    allocated statically from these values, so lower them where the full size
    is not needed.

    Memory per instance with the defaults:
        FB_CounterTimer   CT_CHANNELS x CT_BUFFER_LENGTH x 4 B = 32 MiB
        FB_AnalogOutput   AO_WAVEFORM_LENGTH x 4 B             =  4 MiB
        FB_AnalogInput*   AI_FILTER_MAX_LENGTH x 4 B           =  4 KiB
        FB_FlowMeter      FLOW_BUFFER_LENGTH x 4 B             =  4 KiB
*)
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    // Number of channels of each FB_CounterTimer.
    CT_CHANNELS : UDINT := 8;
    // Maximum number of points per FB_CounterTimer channel.
    CT_BUFFER_LENGTH : UDINT := 1048576;
    // Maximum number of waveform points of each FB_AnalogOutput.
    AO_WAVEFORM_LENGTH : UDINT := 1048576;
    // Maximum moving-average length of the analog input blocks.
    AI_FILTER_MAX_LENGTH : UDINT := 1000;
    // Maximum number of rising edges per second FB_FlowMeter can count.
    FLOW_BUFFER_LENGTH : UDINT := 1000;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
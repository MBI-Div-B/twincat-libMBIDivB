<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="OutputBuffer" Id="{6b186138-0550-4be7-ae3c-f50b66a8d887}" SpecialFunc="None">
    <Declaration><![CDATA[
(*
Output arbitrary values from buffer.
*Variables*

State:
    - 0: initialize buffer array values - only internal use
    - 1: stopped - output is kept at last value
    - 2: start - begin loop at first index
    - 3: running - in loop

Repeats: number of repeats for entire array. Zero for unlimited repeats.

IndexMax: Number of values to use from buffer.
*)
FUNCTION_BLOCK OutputBuffer
VAR_OUTPUT
    Value: REAL;
    State: UDINT;
END_VAR
VAR
    Buffer: ARRAY[0 .. globals.MAX_BUFFER_LENGTH] OF REAL;
    IndexCurr: UDINT := 0;
    IndexMax: UDINT;
    IndexDelay: UDINT := 0;
    TicksDelay: UDINT;
    Repeats: UDINT;
    RepeatCount: UDINT;
    i: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IndexMax := MIN(IndexMax, globals.MAX_BUFFER_LENGTH);
TicksDelay := MIN(1, TicksDelay);

IF State = 0 THEN // init
    FOR i := 1 TO globals.MAX_BUFFER_LENGTH BY 1 DO
        Buffer[i] := 0;
    END_FOR
    State := 2;
END_IF

IF State = 2 THEN  // start output from beginning
    IndexCurr := 0;
    RepeatCount := 0;
    State := 3;
END_IF

IF State = 3 THEN  // running
    IndexDelay := IndexDelay + 1;
    IF IndexDelay >= TicksDelay THEN
        IndexCurr := IndexCurr + 1;
        IndexDelay := 0;
    END_IF

    IF IndexCurr > IndexMax THEN
        IndexCurr := 0;
        RepeatCount := RepeatCount + 1;
    END_IF

    IF Repeats > 0 AND RepeatCount >= Repeats THEN
        State := 1;
    END_IF
END_IF

IF State = 4 THEN  // just for testing
    FOR i := 1 TO 10000 BY 1 DO
        Buffer[i] := SIN(3.1415927 * UDINT_TO_REAL(i) / 100.0);
        IndexMax := 10000;
        State := 1;
    END_FOR
END_IF

Value := Buffer[IndexCurr];
]]></ST>
    </Implementation>
    <Method Name="setCurrentIndex" Id="{3af0025c-8580-45eb-89b4-764fdc0656d5}">
      <Declaration><![CDATA[
METHOD setCurrentIndex
VAR_INPUT
    Index: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IndexCurr := Index;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setIndexMax" Id="{184b75c4-2b48-45cb-8049-79e967324f0a}">
      <Declaration><![CDATA[
METHOD setIndexMax
VAR_INPUT
    Value: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IndexMax := Value;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setState" Id="{ffa1a1e0-70d0-46ec-a93f-08296760f65f}">
      <Declaration><![CDATA[
METHOD setState
VAR_INPUT
    Target: WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
State := Target;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
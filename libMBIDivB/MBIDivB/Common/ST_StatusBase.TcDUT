<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_StatusBase" Id="{0b4f7418-ca7b-4a97-85e7-ae0788280b00}">
    <Declaration><![CDATA[
(*
    Members common to the Status structure of every block. Each block's
    ST_<Block>Status extends this structure, so these members appear directly
    under <instance>.Status, e.g. MAIN.Acq.Status.State.

    State and StateText are documented in each block's declaration header.
    Error and ErrorText follow the rules in README.md, "Interface conventions":
    an error from a command or method call stays until the next accepted
    command or call of the same block; an error from a condition (terminal
    status bit, invalid live parameter) is shown while the condition lasts.
*)
TYPE ST_StatusBase :
STRUCT
    State : INT;                // state code of the block
    StateText : STRING(20);     // name of the state, e.g. 'IDLE'
    Error : BOOL;               // TRUE while an error is reported
    ErrorText : STRING(80);     // what failed and why; empty without error
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
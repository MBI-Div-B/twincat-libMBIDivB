<?xml version='1.0' encoding='UTF-8'?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ShutdownCmd" Id="{760f5e55-a6af-422c-acfe-20b808b3c8b2}">
    <Declaration><![CDATA[
(*
    Commands of FB_PlcShutdown. Write TRUE; the block sets the flag back to
    FALSE when it has processed the command.
*)
TYPE ST_ShutdownCmd :
STRUCT
    Shutdown : BOOL;    // shut down the operating system of this PLC after Cfg.DelayMs
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>